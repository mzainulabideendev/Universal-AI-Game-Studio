# LLM environment example — NO REAL SECRETS
# Copy values into your shell or MCP client environment. This file is not
# loaded automatically, and real keys must never be committed.

# --- provider selection ---------------------------------------------------
# openai | openai_compatible | anthropic | gemini | ollama
GAME_STUDIO_LLM_PROVIDER=ollama
GAME_STUDIO_LLM_MODEL=llama3.1
# Optional custom endpoint (required for openai_compatible / self-hosted)
GAME_STUDIO_LLM_BASE_URL=http://127.0.0.1:11434

# --- credentials ----------------------------------------------------------
# Preferred shared variable for any hosted provider:
# GAME_STUDIO_LLM_API_KEY=replace-me
# Or provider-specific:
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GEMINI_API_KEY=replace-me

# --- safety / privacy -----------------------------------------------------
GAME_STUDIO_LLM_LOCAL_ONLY=false
GAME_STUDIO_LLM_ALLOW_PROJECT_CONTENT=false
GAME_STUDIO_LLM_CACHE=false

# --- budgets / timeouts ---------------------------------------------------
GAME_STUDIO_LLM_CONNECT_TIMEOUT=10
GAME_STUDIO_LLM_TIMEOUT=60
GAME_STUDIO_LLM_MAX_TOKENS=4096
GAME_STUDIO_LLM_MAX_CONTEXT_CHARS=64000
GAME_STUDIO_LLM_MAX_REQUESTS=20
GAME_STUDIO_LLM_MAX_REQUESTS_PER_DAY=200
GAME_STUDIO_LLM_RETRIES=2
GAME_STUDIO_LLM_BACKOFF=1.5
GAME_STUDIO_LLM_TEMPERATURE=0.2
